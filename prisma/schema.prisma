generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler (pgBouncer) — para la app
  directUrl = env("DIRECT_URL") // conexión directa — para migraciones
}

model Document {
  id           String   @id @default(cuid())
  title        String
  originalPath String // PDF subido
  signedPath   String? // PDF final firmado
  status       String   @default("DRAFT") // DRAFT | SENT | COMPLETED | CANCELLED
  finalHash    String? // SHA-256 del PDF firmado
  createdAt    DateTime @default(now())
  signers      Signer[]
}

model Signer {
  id           String    @id @default(cuid())
  documentId   String
  name         String
  email        String
  order        Int       @default(0) // orden de firma (opcional)
  status       String    @default("PENDING") // PENDING | SIGNED
  signToken    String    @unique // enlace único de firma
  signatureImg String? // PNG base64 o ruta del trazo
  signedAt     DateTime?
  evidence     Json? // ver sección 6 — Postgres soporta Json nativo
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  placements   SignaturePlacement[]
}

/// Dónde se dibuja la firma de un firmante sobre el PDF.
/// Un firmante puede tener varios: la firma en el renglón final y una rúbrica
/// por hoja. Coordenadas en fracciones 0..1 con origen ABAJO-IZQUIERDA, igual
/// que pdf-lib, para no convertir nada al incrustar.
model SignaturePlacement {
  id       String @id @default(cuid())
  signerId String
  page     Int // índice 0-based sobre el PDF YA fusionado con anexos
  x        Float // fracción del ancho de página
  y        Float // fracción del alto, medida desde abajo
  width    Float // fracción del ancho de página
  height   Float // fracción del alto de página
  kind     String @default("SIGNATURE") // SIGNATURE | INITIAL
  signer   Signer @relation(fields: [signerId], references: [id], onDelete: Cascade)

  @@index([signerId])
}

